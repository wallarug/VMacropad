        "button4":  {"eos": "Recall From",    "key": ""},

        "button5":  {"eos": "Color Palette",  "key": ""},
        "button6":  {"eos": "Beam Palette",   "key": ""},
        "button7":  {"eos": "Update",         "key": ""},
        "button8":  {"eos": "Copy To",        "key": ""},

        "button9":  {"eos": "Preset",         "key": ""},
        "button10": {"eos": "Sub",            "key": ""},
        "button11": {"eos": "Group",          "key": ""},
