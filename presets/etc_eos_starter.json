{
    "_readme": [
        "ETC Eos starter preset for the 16-button + 3-knob macropad.",
        "Import via the IMPORT button in the sidebar, then UPLOAD to the pad.",
        "",
        "Only the shortcuts that are well-established are filled in below",
        "(Live=F1, Blind=F2). The remaining Eos command keys need their exact",
        "PC keyboard shortcut from your ETC Eos shortcuts page. '_suggested_layout'",
        "lists a proposed function per control with the shortcut left blank ('').",
        "Fill the blanks, move the entry into 'controls', then re-import.",
        "",
        "Spec format per control:",
        "  {\"key\": \"<name from KEY_MAP>\", \"ctrl\": true, \"shift\": true, \"alt\": true, \"win\": true}",
        "  {\"media\": \"<name from MEDIA_MAP>\"}",
        "  {\"mouse\": \"<name>\", \"scroll\": \"<name>\"}",
        "Control names: button1..button16, knob1_ccw/cw/press .. knob3_ccw/cw/press",
        "Note: Eos hardkey emulation from a keyboard generally requires Scroll Lock ON."
    ],
    "name": "ETC EOS",
    "color": "#2a6bd4",
    "led": 0,
    "controls": {
        "button1": {"key": "F1"},
        "button2": {"key": "F2"}
    },
    "_suggested_layout": {
        "button1":  {"eos": "Live",        "key": "F1"},
        "button2":  {"eos": "Blind",       "key": "F2"},
        "button3":  {"eos": "At",          "key": ""},
        "button4":  {"eos": "Full",        "key": ""},
        "button5":  {"eos": "Out",         "key": ""},
        "button6":  {"eos": "Thru",        "key": ""},
        "button7":  {"eos": "+",           "key": ""},
        "button8":  {"eos": "-",           "key": ""},
        "button9":  {"eos": "Sneak",       "key": ""},
        "button10": {"eos": "Last",        "key": ""},
        "button11": {"eos": "Next",        "key": ""},
        "button12": {"eos": "Select Last", "key": ""},
        "button13": {"eos": "Go To Cue",   "key": ""},
        "button14": {"eos": "Clear",       "key": ""},
        "button15": {"eos": ".",           "key": ""},
        "button16": {"eos": "Enter",       "key": "Enter"},
        "knob1_ccw":   {"eos": "Page Down",  "key": "Page Down"},
        "knob1_cw":    {"eos": "Page Up",    "key": "Page Up"},
        "knob1_press": {"eos": "Select",     "key": ""},
        "knob2_ccw":   {"eos": "Last",       "key": ""},
        "knob2_cw":    {"eos": "Next",       "key": ""},
